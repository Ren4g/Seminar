{
  "name": "multilingual-audio-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the multilingual automatic audio-guide system",
  "scripts": {
    "build": "tsc",
    "db:migrate": "node dist/database/migrate.js",
    "db:demo": "node dist/database/seed-demo.js",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^11.2.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
