NODE_ENV=development
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=audio_guide
PGUSER=guide
PGPASSWORD=guide
JWT_SECRET=replace-with-a-long-random-secret
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GOOGLE_TRANSLATE_API_KEY=replace-with-google-cloud-translation-key
MEDIA_DIR=storage
TTS_FALLBACK_AUDIO_PATH=
MAX_AUDIO_FILE_BYTES=10485760
PUBLIC_VISITOR_URL=http://localhost:5173/visitor
# thay bằng IP wi-fi nội bộ của máy bạn (hoặc localhost nếu chạy trên cùng máy với frontend)
# vd Máy tính của tui đang có IP Wi-Fi nội bộ là: 10.60.25.190
# PUBLIC_VISITOR_URL=http://10.60.25.190:5173/visitor
DEFAULT_VISITOR_LANGUAGE=vi
